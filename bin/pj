#!/usr/bin/env bash
set -e
cd $HOME

dir=$(find code/ -maxdepth 4 -name .git | xargs -I{} dirname {} | fzf --reverse)
if [[ -z $dir ]]; then
    cd -
    exit 1
fi

name=$(basename "$dir")
if ! tmux ls -F '#{session_name}' | grep -q "$name"; then
    tmux new -d -s "$name" -c "$dir" 'bash -c emacs'
fi

cd -

if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$name"
else
    tmux attach -t "$name"
fi
